<td style="padding: 0; text-align: center; vertical-align: middle; font-size:1em;"><img src="./f6d31a88.gif" style="margin: 2px;border: 0; vertical-align: middle; width:auto;" title="i" alt="glyph" height="95"/></td><td style="padding: 0; text-align: center; vertical-align: middle; font-size:1em;"><img src="./6c9cd1c6.gif" style="margin: 2px;border: 0; vertical-align: middle; width:auto;" title="n" alt="glyph" height="12"/><br /><img src="./78c461f0.gif" style="margin: 2px;border: 0; vertical-align: middle; width:auto;" title="p" alt="glyph" height="37"/></td>
