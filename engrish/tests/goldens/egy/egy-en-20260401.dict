</td></tr></table> or <table class="mw-hiero-table mw-hiero-outer" dir="ltr" style=" border: 0; border-spacing: 0; font-size:1em;"><tr><td style="padding: 0; text-align: center; vertical-align: middle; font-size:1em;">
<table class="mw-hiero-table" style="border: 0; border-spacing: 0; font-size:1em;"><tr>
