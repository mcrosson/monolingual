<?xml version="1.0" encoding="UTF-8"?>
<ncx xmlns="http://www.daisy.org/z3986/2005/ncx/" version="2005-1">
  <head>
    <meta name="dtb:uid" content="engrish-sampler-{{ form }}"/>
    <meta name="dtb:depth" content="2"/>
    <meta name="dtb:totalPageCount" content="0"/>
    <meta name="dtb:maxPageNumber" content="0"/>
  </head>
  <docTitle><text>Engrish Dictionary Sampler — {{ form }}</text></docTitle>
  <navMap>
    {%- set counter = namespace(n=1) %}
    {% for ch in chapters %}
    <navPoint id="np-{{ ch.id }}" playOrder="{{ counter.n }}">
      <navLabel><text>{{ ch.title }}</text></navLabel>
      <content src="{{ ch.nav_target }}"/>
      {%- set counter.n = counter.n + 1 %}
      {%- for sub in ch.children %}
      <navPoint id="np-{{ sub.id }}" playOrder="{{ counter.n }}">
        <navLabel><text>{{ sub.title }}</text></navLabel>
        <content src="{{ sub.filename }}"/>
      </navPoint>
      {%- set counter.n = counter.n + 1 %}
      {%- endfor %}
    </navPoint>
    {% endfor %}
  </navMap>
</ncx>
